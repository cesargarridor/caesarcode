FROM maven:3-eclipse-temurin-{{java_version}} AS build
WORKDIR /workspace
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:{{java_version}}-jre
WORKDIR /app
COPY --from=build /workspace/target/*.jar app.jar
EXPOSE {{port}}
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
